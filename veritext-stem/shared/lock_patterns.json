{
 "_comment": "GENERATED by scripts/gen_lock_patterns.py; edit that file, not this one. Order = priority.",
 "rules": [
  {
   "id": "escape-brackets",
   "kind": "X",
   "pattern": "[⟦⟧]"
  },
  {
   "id": "md-code-fence",
   "kind": "K",
   "pattern": "^[ \\t]*(```|~~~)[^\\n]*\\n[\\s\\S]*?^[ \\t]*\\1[ \\t]*$",
   "flags": "m"
  },
  {
   "id": "latex-verbatim",
   "kind": "K",
   "pattern": "\\\\begin\\{(verbatim|lstlisting|minted|Verbatim)\\}[\\s\\S]*?\\\\end\\{\\1\\}"
  },
  {
   "id": "latex-float",
   "kind": "K",
   "pattern": "\\\\begin\\{(figure|table|tabular|thebibliography|tikzpicture|algorithm)(\\*?)\\}[\\s\\S]*?\\\\end\\{\\1\\2\\}"
  },
  {
   "id": "latex-math-env",
   "kind": "M",
   "pattern": "\\\\begin\\{(equation|align|gather|multline|eqnarray|displaymath|math|split|alignat|flalign)(\\*?)\\}[\\s\\S]*?\\\\end\\{\\1\\2\\}"
  },
  {
   "id": "display-math-dollars",
   "kind": "M",
   "pattern": "\\$\\$[\\s\\S]+?\\$\\$"
  },
  {
   "id": "display-math-brackets",
   "kind": "M",
   "pattern": "\\\\\\[[\\s\\S]+?\\\\\\]"
  },
  {
   "id": "inline-math-parens",
   "kind": "M",
   "pattern": "\\\\\\([\\s\\S]+?\\\\\\)"
  },
  {
   "id": "inline-code",
   "kind": "K",
   "pattern": "`[^`\\n]+`"
  },
  {
   "id": "url",
   "kind": "U",
   "pattern": "(?:https?|ftp)://[^\\s<>\\\"'\\]\\)]*[^\\s<>\\\"'\\]\\).,;:!?]"
  },
  {
   "id": "doi",
   "kind": "U",
   "pattern": "(?:doi:\\s?)?(?<![A-Za-z0-9/])10\\.\\d{4,9}/[^\\s<>\\\"']*[^\\s<>\\\"'.,;:!?)\\]]"
  },
  {
   "id": "latex-cite",
   "kind": "C",
   "pattern": "\\\\(?:cite|citep|citet|citealp|citealt|citeauthor|citeyear|parencite|textcite|autocite|footcite)\\*?(?:\\[[^\\]]*\\]){0,2}\\{[^}]*\\}"
  },
  {
   "id": "latex-ref",
   "kind": "R",
   "pattern": "\\\\(?:ref|eqref|autoref|cref|Cref|pageref|label)\\{[^}]*\\}"
  },
  {
   "id": "inline-math-dollar",
   "kind": "M",
   "pattern": "(?<![\\\\$])\\$(?![\\s$])(?:[^$\\n\\\\]|\\\\.)+?(?<![\\s\\\\])\\$(?!\\d)"
  },
  {
   "id": "numeric-citation",
   "kind": "C",
   "pattern": "\\[\\d+(?:\\s?[-–,]\\s?\\d+)*\\]"
  },
  {
   "id": "md-footnote",
   "kind": "C",
   "pattern": "\\[\\^[^\\]\\s]+\\]"
  },
  {
   "id": "author-year-citation",
   "kind": "C",
   "pattern": "\\((?:see |e\\.g\\.,? |cf\\. )?[A-Z][^()\\n]{0,80}?(?:19|20)\\d{2}[a-z]?(?:,\\s?pp?\\.\\s?\\d+(?:[-–]\\d+)?)?\\)"
  },
  {
   "id": "narrative-citation",
   "kind": "C",
   "pattern": "(?<![A-Za-z])[A-Z][A-Za-z'’\\-]+(?: et al\\.| and [A-Z][A-Za-z'’\\-]+| & [A-Z][A-Za-z'’\\-]+)? \\((?:19|20)\\d{2}[a-z]?\\)"
  },
  {
   "id": "figure-table-ref",
   "kind": "R",
   "pattern": "(?<![A-Za-z])(?:Supplementary (?:Fig\\.|Figure|Table)s?|Figs?\\.|Figures?|Tables?|Eqs?\\.|Equations?|Sections?|Sec\\.|Appendix)\\s?~?\\(?[A-Z]?\\d+(?:\\.\\d+)*[a-z]?\\)?(?:\\s?(?:and|[-–,])\\s?\\(?[A-Z]?\\d+[a-z]?\\)?)?"
  },
  {
   "id": "md-heading-marker",
   "kind": "K",
   "pattern": "^#{1,6}[ \\t]+",
   "flags": "m"
  },
  {
   "id": "md-list-marker",
   "kind": "K",
   "pattern": "^[ \\t]*(?:[-*+]|\\d+[.)])[ \\t]+",
   "flags": "m"
  },
  {
   "id": "html-tag",
   "kind": "K",
   "pattern": "</?[A-Za-z][A-Za-z0-9-]*(?:\\s[^<>]*)?/?>"
  },
  {
   "id": "latex-comment",
   "kind": "K",
   "pattern": "(?<!\\\\)%[^\\n]*",
   "formats": [
    "latex"
   ]
  },
  {
   "id": "latex-command",
   "kind": "K",
   "pattern": "\\\\[A-Za-z]+\\*?(?:\\[[^\\]\\n]*\\])*(?:\\{[^{}\\n]*(?:\\{[^{}\\n]*\\}[^{}\\n]*)*\\})*"
  },
  {
   "id": "latex-escape",
   "kind": "K",
   "pattern": "\\\\[^A-Za-z\\s]"
  },
  {
   "id": "ph-value",
   "kind": "N",
   "pattern": "(?<![A-Za-z])pH\\s?\\d+(?:\\.\\d+)?"
  },
  {
   "id": "species-abbrev",
   "kind": "E",
   "pattern": "(?<![A-Za-z.])[A-Z]\\.\\s?[a-z]{3,}(?![A-Za-z])"
  },
  {
   "id": "gene-hyphenated",

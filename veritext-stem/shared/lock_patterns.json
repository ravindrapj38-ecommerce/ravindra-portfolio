   "pattern": "(?<![A-Za-z0-9.])[-−+]?\\d+(?:[.,]\\d+)*(?:[eE][-−+]?\\d+)?(?:\\s?[×x]\\s?10(?:\\^\\{?[-−]?\\d+\\}?|[⁻⁰¹²³⁴⁵⁶⁷⁸⁹]+))?(?:\\^\\{?[-−]?\\d+\\}?)?(?:\\s?(?:±|\\+/-|–|−)\\s?\\d+(?:[.,]\\d+)*(?:[eE][-−+]?\\d+)?(?:\\s?[×x]\\s?10(?:\\^\\{?[-−]?\\d+\\}?|[⁻⁰¹²³⁴⁵⁶⁷⁸⁹]+))?(?:\\^\\{?[-−]?\\d+\\}?)?)?(?:\\s?(?:[yzafpnµμumcdkMGTP]?(?:mol|Hz|Pa|eV|Da|bp|nt|lx|Gy|Sv|Wb|rad|sr|bar|atm|cal|L|l|m|g|s|M|J|W|V|A|N|K|T|F|C|S|H|Ω|ohm)|°C|°F|°|%|‰|ppm|ppb|rpm|min|h|d|yr|wt%|vol%|mol%)(?:\\^\\{?[-−]?\\d+\\}?|[⁻]?[⁰¹²³⁴⁵⁶⁷⁸⁹]+|[-−]\\d+)?(?:\\s?[/·]\\s?(?:[yzafpnµμumcdkMGTP]?(?:mol|Hz|Pa|eV|Da|bp|nt|lx|Gy|Sv|Wb|rad|sr|bar|atm|cal|L|l|m|g|s|M|J|W|V|A|N|K|T|F|C|S|H|Ω|ohm)|°C|°F|°|%|‰|ppm|ppb|rpm|min|h|d|yr|wt%|vol%|mol%)(?:\\^\\{?[-−]?\\d+\\}?|[⁻]?[⁰¹²³⁴⁵⁶⁷⁸⁹]+|[-−]\\d+)?|\\s(?:[yzafpnµμumcdkMGTP]?(?:mol|Hz|Pa|eV|Da|bp|nt|lx|Gy|Sv|Wb|rad|sr|bar|atm|cal|L|l|m|g|s|M|J|W|V|A|N|K|T|F|C|S|H|Ω|ohm)|°C|°F|°|%|‰|ppm|ppb|rpm|min|h|d|yr|wt%|vol%|mol%)(?:\\^\\{?[-−]?\\d+\\}?|[⁻]?[⁰¹²³⁴⁵⁶⁷⁸⁹]+|[-−]\\d+))*(?![A-Za-z]))?"

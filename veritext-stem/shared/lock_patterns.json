  },
  {
   "id": "chemical-formula",
   "kind": "E",
   "filter": "formula",
   "pattern": "(?<![A-Za-z0-9])(?:(?:He|Li|Be|Ne|Na|Mg|Al|Si|Cl|Ar|Ca|Sc|Ti|Cr|Mn|Fe|Co|Ni|Cu|Zn|Ga|Ge|As|Se|Br|Kr|Rb|Sr|Zr|Nb|Mo|Tc|Ru|Rh|Pd|Ag|Cd|In|Sn|Sb|Te|Xe|Cs|Ba|La|Ce|Pr|Nd|Pm|Sm|Eu|Gd|Tb|Dy|Ho|Er|Tm|Yb|Lu|Hf|Ta|Re|Os|Ir|Pt|Au|Hg|Tl|Pb|Bi|Po|At|Rn|Fr|Ra|Ac|Th|Pa|Np|Pu|Am|Cm|Bk|Cf|Es|Fm|Md|No|Lr|H|B|C|N|O|F|P|S|K|V|Y|I|W|U)\\d*|\\((?:(?:He|Li|Be|Ne|Na|Mg|Al|Si|Cl|Ar|Ca|Sc|Ti|Cr|Mn|Fe|Co|Ni|Cu|Zn|Ga|Ge|As|Se|Br|Kr|Rb|Sr|Zr|Nb|Mo|Tc|Ru|Rh|Pd|Ag|Cd|In|Sn|Sb|Te|Xe|Cs|Ba|La|Ce|Pr|Nd|Pm|Sm|Eu|Gd|Tb|Dy|Ho|Er|Tm|Yb|Lu|Hf|Ta|Re|Os|Ir|Pt|Au|Hg|Tl|Pb|Bi|Po|At|Rn|Fr|Ra|Ac|Th|Pa|Np|Pu|Am|Cm|Bk|Cf|Es|Fm|Md|No|Lr|H|B|C|N|O|F|P|S|K|V|Y|I|W|U)\\d*)+\\)\\d*)+(?:\\d*[+−-](?![A-Za-z0-9]))?(?![a-z0-9])"
  },
  {
   "id": "gene-symbol",
   "kind": "E",
   "pattern": "(?<![A-Za-z0-9])(?:[A-Z][A-Za-z]{0,6}\\d+[A-Za-z]?|p\\d{2,3}|m[A-Z]{2,}\\d*)\\+?(?![A-Za-z0-9])"
  },
  {
   "id": "acronym",
   "kind": "A",
   "filter": "acronym",
   "pattern": "(?<![A-Za-z0-9])[A-Z][A-Z0-9]{1,7}s?(?![A-Za-z0-9])"

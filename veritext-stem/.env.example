# Copy to apps/web/.env.local for local work, or set these in your host (Vercel > Settings >
# Environment Variables). Never commit real values. Keep in sync with apps/web/lib/server/config.ts
# and services/engine/veritext_engine/config.py.

# --- Rewriting ---------------------------------------------------------------------------------
# Claude API key (console.anthropic.com). Without it the app runs the demo rewriter and charges nothing.
ANTHROPIC_API_KEY=
VERITEXT_MODEL_REWRITE=claude-opus-5-5
# low | medium | high. Higher = more careful, slower and more expensive per word.
VERITEXT_EFFORT=low
VERITEXT_CONCURRENCY=6
VERITEXT_MAX_REPAIR_ATTEMPTS=3
# Free words per month for one IP address across all browsers (abuse backstop).
VERITEXT_FREE_IP_WORDS=15000
# USD per million tokens for the model above; used only for the cost report.
VERITEXT_PRICE_INPUT=4
VERITEXT_PRICE_OUTPUT=20
VERITEXT_PRICE_CACHE_READ=0.2
VERITEXT_PRICE_CACHE_WRITE=5

# --- Payments (Lemon Squeezy) --------------------------------------------------------------------
# Settings > Stores > store ID (a number).
LEMONSQUEEZY_STORE_ID=
# Variant IDs (numbers, comma-separated). Researcher: the monthly and the yearly variant.
# Pack: the one-time variant.
LEMONSQUEEZY_RESEARCHER_VARIANT_IDS=
LEMONSQUEEZY_PACK_VARIANT_IDS=
# Checkout links (Products > Share > Copy URL).
VERITEXT_CHECKOUT_MONTHLY=
VERITEXT_CHECKOUT_YEARLY=
VERITEXT_CHECKOUT_PACK=
# Customer portal, e.g. https://YOURSTORE.lemonsqueezy.com/billing
VERITEXT_BILLING_PORTAL=
# Set to 1 only while testing with Lemon Squeezy test-mode keys on the deployed site.
VERITEXT_ALLOW_TEST_KEYS=

# --- Site ----------------------------------------------------------------------------------------
VERITEXT_SITE_URL=http://localhost:3000
VERITEXT_SUPPORT_EMAIL=support@example.com
VERITEXT_OWNER_NAME=
VERITEXT_OWNER_COUNTRY=India

# --- Sessions, usage storage, admin --------------------------------------------------------------
# 32+ random characters (openssl rand -hex 32). Required in production.
VERITEXT_SESSION_SECRET=
# Upstash Redis (upstash.com, free tier). Stores word counts and cost totals; never document text.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Any long random string; protects /api/admin/stats.
VERITEXT_ADMIN_TOKEN=

# --- Optional: Python engine (API/CLI work; the web app does not need it) ------------------------
# When set, the web app proxies rewrites to the engine instead of calling Claude itself.
ENGINE_URL=
VERITEXT_PROVIDER=auto
VERITEXT_MODEL_JUDGE=claude-sonnet-5-5
VERITEXT_MODEL_CLASSIFY=claude-haiku-5-5
VERITEXT_MAX_INPUT_CHARS=60000
VERITEXT_CORS_ORIGINS=http://localhost:3000

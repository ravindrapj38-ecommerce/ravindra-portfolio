# Copy to .env (never commit .env). Keep in sync with services/engine/veritext_engine/config.py.

# Claude API key for real rewrites. Without it the engine uses the offline demo rewriter.
ANTHROPIC_API_KEY=

# auto | anthropic | demo
VERITEXT_PROVIDER=auto
VERITEXT_MODEL_REWRITE=claude-opus-5-5
VERITEXT_MODEL_JUDGE=claude-sonnet-5-5
VERITEXT_MODEL_CLASSIFY=claude-haiku-5-5
VERITEXT_MAX_REPAIR_ATTEMPTS=3
VERITEXT_MAX_INPUT_CHARS=60000
VERITEXT_CORS_ORIGINS=http://localhost:3000

# Web app: where the Next.js server reaches the engine.
ENGINE_URL=http://127.0.0.1:8000
